# Normaliza los finales de línea en el repositorio a LF.
# Evita diffs inflados y los "modificados" fantasma por mezclar CRLF y LF.
* text=auto eol=lf

# Binarios: nunca tratarlos como texto (git los detecta solo, pero así
# queda explícito y no depende de heurísticas).
*.png binary
*.PNG binary
*.jpg binary
*.JPG binary
*.jpeg binary
*.JPEG binary
*.ico binary
*.ICO binary
*.webp binary
*.gif binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
