# Configuración de Supabase
SUPABASE_URL=tu_url_de_supabase
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Configuración de Gemini AI
GEMINI_API_KEY=tu_gemini_api_key

# Configuración de Anthropic (Claude)
ANTHROPIC_API_KEY=tu_anthropic_api_key

# Configuración de Brevo (Sendinblue)
BREVO_API_KEY=tu_brevo_api_key

# ID de la plantilla de Reto Diario en Brevo
RETO_DIARIO_TEMPLATE_ID=24

# URL de la App (para enlaces en emails)
APP_URL=https://despierta-tu-voz-app.vercel.app

# Configuración de Stripe
STRIPE_SECRET_KEY=tu_stripe_secret_key
STRIPE_PRICE_PRO=tu_price_id_pro
STRIPE_PRICE_PREMIUM=tu_price_id_premium
STRIPE_WEBHOOK_SECRET=tu_webhook_secret

# ── Seguridad de webhooks ────────────────────────────────────────────────
# Secreto de firma de Cal.com (Settings → Developer → Webhooks).
# Si no está definido, /api/calcom-webhook RECHAZA todas las peticiones.
CALCOM_WEBHOOK_SECRET=tu_calcom_webhook_secret

# Secreto para derivar el hash de los tokens de verificación de email.
# Recomendado: cadena aleatoria larga (openssl rand -hex 32).
EMAIL_TOKEN_SECRET=tu_secreto_aleatorio_largo

# Permite aceptar webhooks sin firma cuando NO hay secreto configurado.
# Solo para desarrollo local. En producción déjalo en false: con la
# configuración por defecto los webhooks sin firma se rechazan.
ALLOW_UNVERIFIED_WEBHOOKS=false

# Remitente de los emails transaccionales (Brevo)
BREVO_SENDER_NAME=Fernando - Despierta tu Voz
BREVO_SENDER_EMAIL=app-mentor@despiertatuvoz.com

# ── Monitorización de errores (tipo Sentry) ──────────────────────────────
# DSN del proyecto. Si se deja vacío, los errores se registran en consola
# y en un buffer consultable vía /api/health. Sin dependencias extra.
SENTRY_DSN=
APP_VERSION=1.0.6
